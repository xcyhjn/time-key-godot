[gd_resource type="Resource" script_class="CraftRecipeBook" load_steps=4 format=3]

[ext_resource type="Script" path="res://scene/in_scene/rewards/resources/CraftRecipeBook.gd" id="1_recipe_book"]
[ext_resource type="Script" path="res://scene/in_scene/rewards/resources/CraftRecipeEntry.gd" id="2_recipe_entry"]

[sub_resource type="Resource" id="Resource_wind_tower"]
script = ExtResource("2_recipe_entry")
card_a_id = "wind"
card_b_id = "tower"
result_card_id = "tornado"

[sub_resource type="Resource" id="Resource_lighting_earthquake"]
script = ExtResource("2_recipe_entry")
card_a_id = "lighting"
card_b_id = "earthquake"
result_card_id = "poison"

[resource]
script = ExtResource("1_recipe_book")
recipes = Array[Resource]([SubResource("Resource_wind_tower"), SubResource("Resource_lighting_earthquake")])
